<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.meeting.mapper.DeviceInfoMapper">
    
    <resultMap type="com.ruoyi.meeting.domain.DeviceInfo" id="DeviceInfoResult">
        <result property="id" column="id"/>
        <result property="deviceSerial" column="device_serial"/>
        <result property="deviceName" column="device_name"/>
        <result property="deviceIp" column="device_ip"/>
        <result property="devicePort" column="device_port"/>
        <result property="deviceStatus" column="device_status"/>
        <result property="extInfo" column="ext_info"/>
        <result property="orderNo" column="order_no"/>
        <result property="deleted" column="deleted"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectDeviceInfoVo">
        select id, device_serial, device_name, device_ip, device_port, device_status, ext_info, order_no, deleted, create_by, create_time, update_by, update_time, remark from bus_device_info
    </sql>

    <select id="selectDeviceInfoList" parameterType="com.ruoyi.meeting.domain.DeviceInfo" resultMap="DeviceInfoResult">
        <include refid="selectDeviceInfoVo"/>
        <where>  
            <if test="deviceSerial != null  and deviceSerial != ''"> and device_serial like concat('%', #{deviceSerial}, '%')</if>
            <if test="deviceName != null  and deviceName != ''"> and device_name like concat('%', #{deviceName}, '%')</if>
            <if test="deviceStatus != null  and deviceStatus != ''"> and device_status = #{deviceStatus}</if>
        </where>
    </select>

</mapper>